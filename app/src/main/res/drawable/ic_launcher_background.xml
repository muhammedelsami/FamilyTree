<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer.

  Deliberately a flat diagonal gradient and nothing else: the launcher masks this layer
  to whatever shape the device uses and may parallax it behind the foreground, so any
  detail here is detail that can be cropped or slid out of view. The two stops are the
  brand evergreen at its lightest and darkest usable tones (Pine, see the design
  system's Color.kt), which is what ties the icon to the app it opens.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF2F7757"
                    android:offset="0" />
                <item
                    android:color="#FF123526"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
