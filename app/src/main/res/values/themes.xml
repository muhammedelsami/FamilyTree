<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the launch window uses this; everything after `setContent` is themed by
      FamilyTreeTheme in Compose. Transparent bars let edge-to-edge take over cleanly
      instead of flashing a system-coloured strip on start.

      The AppCompat parent is not decoration: MainActivity is an AppCompatActivity so that
      the per-app language API works below Android 13 (see AppLocales), and AppCompat
      refuses to start under a plain platform theme. DayNight also lets the launch window
      follow dark mode, which the fixed `Light` parent could not.
    -->
    <style name="Theme.FamilyTree" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <!--
      The theme the activity is *launched* with, and only that: `installSplashScreen()`
      swaps it for Theme.FamilyTree before AppCompat looks at the window, which is why
      this one may sit on a non-AppCompat parent without breaking the language API.

      The name says `Theme.FamilyTree.Starting` but the parent is Theme.SplashScreen —
      the explicit parent wins over the dotted name, and this is the naming AndroidX's
      own documentation uses.
    -->
    <style name="Theme.FamilyTree.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!--
          The launcher icon's own foreground layer, so the icon the user pressed is the
          mark that comes up — unmasked, on the brand colour its background layer is drawn
          in. Android shows the middle two thirds of a 288dp canvas here, which is the
          same proportion the adaptive-icon mask leaves, so the layer needs no second
          copy at a different size.
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FamilyTree</item>
        <!-- The splash is dark in both themes, so the system bars stay light on it. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
